# Production: public DNS name pointing to this server. Ports 80 and 443 must be open.
DOMAIN=contest.example.org
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=
# Run on server: stat -c '%g' /var/run/docker.sock
DOCKER_GID=
# Use a different prefix for every installation sharing the same Docker daemon.
JUDGE_PREFIX=department-judge

# Shared login limits: attempts in a 15-minute window; high IP limit accommodates classrooms.
LOGIN_ACCOUNT_LIMIT=8
LOGIN_IP_LIMIT=300
LOGIN_WINDOW_SECONDS=900
# Warn teachers and operational checks after this queue wait.
QUEUE_WARNING_SECONDS=120
