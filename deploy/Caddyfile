{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 16MB
    }
    handle_path /static/* {
        root * /srv/static
        file_server
    }
    handle {
        reverse_proxy web:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        -Server
    }
}
